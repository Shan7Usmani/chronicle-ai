# Supabase (Postgres + storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: "gemini" | "groq" | "simulation" (simulation = no key needed, template writer)
LLM_PROVIDER=simulation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret guarding /api/agent/tick and /api/agent/init
AGENT_SECRET=chronicle-dev-secret

# Deployment origin (set on Vercel; used for canonical feed links)
SITE_URL=

# Max posts published per scheduled tick
MAX_POSTS_PER_TICK=2

# Minutes after init before the first post slot (dev/demo: set ~0.5 to see posts in seconds)
PUBLISH_FIRST_SLOT_MIN=15
